# Local development server
PORT=3000
REQUEST_TIMEOUT_SECONDS=8
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Local PostgreSQL from docker-compose.yml
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lume?sslmode=disable

# Development-only JWT settings
JWT_SECRET=segredo-local-apenas-desenvolvimento
JWT_EXPIRATION=24h

# External book APIs
OPEN_LIBRARY_BASE_URL=https://openlibrary.org
GOOGLE_BOOKS_BASE_URL=https://www.googleapis.com/books/v1
# Optional fallback API key. Leave empty for local development.
GOOGLE_BOOKS_API_KEY=
