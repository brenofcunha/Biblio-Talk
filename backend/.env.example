# ── Servidor ──────────────────────────────────────────────
PORT=3000
REQUEST_TIMEOUT_SECONDS=8
CORS_ALLOWED_ORIGIN=http://localhost:5173

# ── Banco de dados (PostgreSQL / Supabase) ───────────────
# Local (docker-compose): postgres://postgres:postgres@localhost:5432/lume?sslmode=disable
# Supabase (produção): use a connection string do painel do Supabase (Transaction pooler) com sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lume?sslmode=disable

# ── JWT ───────────────────────────────────────────────────
# Em produção use um segredo longo e aleatório: `openssl rand -hex 32`
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRATION=24h

# ── Integração com API externa de livros ──────────────────
# Open Library é usada por padrão (sem chave). A Google Books entra como fallback quando a chave estiver preenchida.
OPEN_LIBRARY_BASE_URL=https://openlibrary.org
GOOGLE_BOOKS_BASE_URL=https://www.googleapis.com/books/v1
# Opcional: chave da Google Books API (https://console.cloud.google.com/apis/credentials)
GOOGLE_BOOKS_API_KEY=
